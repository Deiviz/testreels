      activePlayerId = playerDiv.id;
      const player = jwplayer(activePlayerId);
      const modal = document.getElementById("trackModal");
      const list = document.getElementById("modalList");
      const title = document.getElementById("modalTitle");

      list.innerHTML = ""; // Limpiar lista
      modal.style.display = "flex";

      if (type === "audio") {
        title.innerText = "Idioma do áudio";
        const tracks = player.getAudioTracks();
        const current = player.getCurrentAudioTrack();

        tracks.forEach((track, index) => {
          const li = document.createElement("li");
          li.innerText = track.name || `Pista ${index}`;
          if (index === current) li.className = "active";
          li.onclick = () => {
            player.setCurrentAudioTrack(index);
            closeModal();
          };
          list.appendChild(li);
        });
      } else {
        title.innerText = "Legendas";
        const captions = player.getCaptionsList(); // Incluye "Off"
        const current = player.getCurrentCaptions();

        captions.forEach((cap, index) => {
          const li = document.createElement("li");
          li.innerText = cap.label;
          if (index === current) li.className = "active";
          li.onclick = () => {
            player.setCurrentCaptions(index);
            closeModal();
          };
          list.appendChild(li);
        });
      }
    }

