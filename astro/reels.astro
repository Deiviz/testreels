</Layout>

<style is:global>

body,
      html {
        margin: 0;
        padding: 0;
        /*height: 100%;*/
        /*overflow: hidden;*/
        background-color: #000;
      }

      :root {
        --reels-viewport-height: 100vh;
        --reels-sticky-nav-height: 62px;
      }

      @supports (height: 100dvh) {
        :root {
          --reels-viewport-height: 100dvh;
        }
      }

      .tiktok-container {
        width: 100%;
        /* !important evita que el bundle global antiguo vuelva a imponer 100vh. */
        height: var(--reels-viewport-height) !important;
        overflow-y: scroll;
