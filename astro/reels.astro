            Math.ceil(stickyNav.getBoundingClientRect().height) + "px",
          );
        }
      }

      updateReelsViewport();
      window.addEventListener("resize", updateReelsViewport);
      window.addEventListener("orientationchange", updateReelsViewport);
      window.addEventListener("load", updateReelsViewport);
      if (window.visualViewport) {
        window.visualViewport.addEventListener("resize", updateReelsViewport);
        window.visualViewport.addEventListener("scroll", updateReelsViewport);
