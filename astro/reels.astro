            );

            // Si encontramos el track y no es el que ya está seleccionado, lo cambiamos
            if (ptIndex !== -1 && playerInstance.getCurrentAudioTrack() !== ptIndex) {
                playerInstance.setCurrentAudioTrack(ptIndex);
                console.log(`Idioma cambiado a Portugués en el player: ${playerContainer.id}`);
            }
        });
