// 2. Modificamos tu función existente para que actualice los iconos automáticamente
// 2. Modificamos tu función existente para que actualice los iconos automáticamente
function iniciarSincronizacionBarras() {
  const slides = document.querySelectorAll('.slide');

  slides.forEach(slide => {
      const playerContainer = slide.querySelector('.jwplayer');
      const progressBarFill = slide.querySelector('.custom-progress-fill');
      const playBtn = slide.querySelector('.play-pause-btn');

      if (playerContainer) {
          const playerInstance = jwplayer(playerContainer.id);

          // 1. Definimos la lógica de cambio de idioma en una función interna
          const forcePortuguese = () => {
              const tracks = playerInstance.getAudioTracks();
              if (tracks && tracks.length > 0) {
                  const ptIndex = tracks.findIndex(t => 
                      (t.label || t.name || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").includes("portu")
                  );
                  if (ptIndex !== -1 && playerInstance.getCurrentAudioTrack() !== ptIndex) {
                      playerInstance.setCurrentAudioTrack(ptIndex);
                      console.log("Idioma forzado a Portugués en:", playerContainer.id);
                  }
              }
          };

          // 2. Intentamos ejecutarlo de inmediato (por si ya cargó)
          forcePortuguese();

          // 3. Lo dejamos escuchando para cuando cambie el item o carguen metadatos (por si no había cargado aún)
          playerInstance.on('playlistItem', forcePortuguese);
          playerInstance.on('meta', forcePortuguese);

          // --- MANTENER TU LÓGICA DE ICONOS Y BARRA ---
          playerInstance.on('play', () => { if(playBtn) playBtn.innerHTML = SVG_PAUSE; });
          playerInstance.on('pause', () => { if(playBtn) playBtn.innerHTML = SVG_PLAY; });
          
          playerInstance.on('time', function(event) {
              if (event.duration > 0 && progressBarFill) {
                  const porcentaje = (event.position / event.duration) * 100;
                  progressBarFill.style.width = porcentaje + '%';
              }
          });
      }
  });
}


function ajustarTamanoVideoContainer() {
  const videoContainers = document.querySelectorAll(".video-container");
  // Buscamos el primer player que ya esté listo en el DOM
  const playerActual = document.querySelector(".jwplayer");
  const alturaViewport = window.visualViewport?.height || window.innerHeight;
  const stickyNavHeight =
    Number.parseFloat(
      getComputedStyle(document.documentElement).getPropertyValue(
        "--reels-sticky-nav-height",
      ),
    ) || 62;
  const isIphone = document.documentElement.classList.contains("is-iphone");
  const alturaVideo = isIphone
    ? Math.round(alturaViewport - stickyNavHeight)
    : Math.round(alturaViewport);

  if (playerActual && playerActual.offsetHeight > 0) {
      // Obtenemos las dimensiones reales actuales
      const anchoOriginal = playerActual.offsetWidth;
      const altoOriginal = playerActual.offsetHeight;

      const relacionAspecto = anchoOriginal / altoOriginal;
      const nuevoAncho = Math.round(alturaVideo * relacionAspecto);

      videoContainers.forEach((container) => {
          container.style.width = nuevoAncho + "px";
          container.style.height = alturaVideo + "px";
      });
      
      console.log("Tamaño ajustado: " + nuevoAncho + "x" + alturaVideo);
  } else {
      // Si no está listo, reintentamos en 100ms
      setTimeout(ajustarTamanoVideoContainer, 100);
  }
}

// Llamadas seguras
window.addEventListener("load", () => {
  // Intentamos ajustar varias veces para asegurar el renderizado
  ajustarTamanoVideoContainer();
});
window.addEventListener("resize", ajustarTamanoVideoContainer);
if (window.visualViewport) {
  window.visualViewport.addEventListener("resize", ajustarTamanoVideoContainer);
}

